{
  "name": "reading-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Upload a PDF, build reading quizzes and review answers with evidence.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "build": "node scripts/build.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.449",
    "tesseract.js": "^6.0.1"
  }
}
