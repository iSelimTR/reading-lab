PORT=3000
HOST=127.0.0.1

# Optional. The basic quiz works without these values.
# Keep the real key in .env on the server, never in GitHub or browser JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# For DeepSeek use OPENAI_BASE_URL=https://api.deepseek.com and OPENAI_MODEL=deepseek-flash
# Automatically selected for official DeepSeek; optional override for other providers:
# AI_RESPONSE_FORMAT=json_object

# Set this when exposing an AI-enabled server to other devices or the internet.
# The browser will show its standard username/password prompt. Username can be anything.
APP_PASSWORD=
